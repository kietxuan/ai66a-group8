# --- TÊN DỰ ÁN ---
PROJECT_NAME="Planify Pro"
COMPOSE_PROJECT_NAME=planify

# --- TÀI KHOẢN ADMIN ---
ADMIN_USERNAME=Admin
ADMIN_EMAIL=admin@example.com
# Empty disables bootstrap. Existing accounts/passwords are never reset by startup.
ADMIN_PASSWORD=

# SMTP is independent of the admin account. Required for registration/reset OTP emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# --- CẤU HÌNH CỔNG CHO DỰ ÁN ---
HOST_PORT_FRONTEND=3000
HOST_PORT_BACKEND=8000
HOST_PORT_DB=5432
HOST_PORT_REDIS=6379

# --- DATABASE (POSTGRESQL) ---
POSTGRES_USER=POSTGRES_USER
POSTGRES_PASSWORD=YOUR_SECRET_PASSWORD
POSTGRES_DB=YOUR_DATABASE_NAME

# --- REDIS ---
REDIS_PASSWORD=YOUR_SECRET_PASSWORD

# --- BACKEND ---
API_V1_STR=/api/v1

# --- FRONTEND ---
# Vanilla frontend uses the same-origin /api/v1 reverse proxy (no Vite configuration).

# --- JWT ---
SECRET_KEY=replace-with-a-long-random-secret-before-use
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# --- GROQ AI AGENT ---
AI_API_KEY=your_groq_api_key_here
AI_MODEL=openai/gpt-oss-20b
