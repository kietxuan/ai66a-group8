# --- TÊN DỰ ÁN ---
PROJECT_NAME="Planify Pro"
COMPOSE_PROJECT_NAME=planify

# --- TÀI KHOẢN ADMIN ---
ADMIN_USERNAME=Admin
ADMIN_EMAIL=your_email@gmail.com
# Mật khẩu đăng nhập admin riêng; để trống nếu không tạo admin khi khởi động.
ADMIN_PASSWORD=

# --- GMAIL OTP & THÔNG BÁO (không dùng ADMIN_PASSWORD) ---
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
MAIL_PROVIDER=smtp
# For Render use MAIL_PROVIDER=brevo and configure these instead of SMTP_*.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME="Planify Pro"

# --- CẤU HÌNH CỔNG CHO DỰ ÁN ---
HOST_PORT_FRONTEND=3000
HOST_PORT_BACKEND=8000
HOST_PORT_DB=5432
HOST_PORT_REDIS=6379

# --- DATABASE (POSTGRESQL) ---
POSTGRES_USER=POSTGRES_USER
POSTGRES_PASSWORD=YOUR_SECRET_PASSWORD
POSTGRES_DB=YOUR_DATABASE_NAME

# --- REDIS ---
REDIS_PASSWORD=YOUR_SECRET_PASSWORD

# --- BACKEND ---
API_V1_STR=/api/v1

# --- FRONTEND ---
# Vanilla frontend uses the same-origin /api/v1 reverse proxy (no Vite configuration).

# --- JWT ---
SECRET_KEY=replace-with-a-long-random-secret-before-use
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# --- GROQ AI AGENT ---
AI_API_KEY=your_groq_api_key_here
AI_MODEL=openai/gpt-oss-20b
