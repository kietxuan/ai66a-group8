DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/todo_app
TEST_DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/todo_app_test
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_TIMEOUT_SECONDS=20
AI_MAX_COMPLETION_TOKENS=1024
CHAT_EXECUTION_ENABLED=true
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
MAX_REQUEST_BYTES=32768
RATE_LIMIT_ENABLED=true
