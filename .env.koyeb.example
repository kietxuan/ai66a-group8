# Copy values into Koyeb Environment variables; never commit actual credentials.
PROJECT_NAME="Planify Pro"
API_V1_STR=/api/v1
# Neon: percent-encode special characters in password. Do NOT include
# ?sslmode=require or channel_binding; DATABASE_SSL handles TLS with asyncpg.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DATABASE
DATABASE_SSL=true
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
# Upstash: use the Redis protocol URL, NOT the REST endpoint/token.
REDIS_URL=rediss://default:PASSWORD@HOST:6379/0
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET_KEY
ADMIN_EMAIL=admin@planify.local
ADMIN_PASSWORD=
AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b
SCHEDULER_ENABLED=true
